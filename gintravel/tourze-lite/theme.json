    "styles": {
        "spacing": {
            "blockGap": "1.2rem"
        },
        "blocks": {
            "core/post-content": {
                "spacing": {
                    "margin": {
                        "top": "0px"
                    }
                }
            }
        },
        "color": {
            "text": "var(--wp--preset--color--gv-color-text-primary)"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--gv-color-text-primary)"
                },
                "typography": {
                    "fontStyle": "normal",
                    "fontWeight": "400",
                    "lineHeight": "1",
                    "fontFamily": "var(--wp--preset--font-family--poppins)"
                },
                ":hover": {
                    "color": {
                        "text": "var:preset|color|gv-color-accent-hover"
                    }
                }
            },
            "button": {
                "color": {
                    "text": "var(--wp--preset--color--white)",
                    "background": "var(--wp--preset--color--gv-color-accent)"
                }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--host-grotesk)",
                    "fontStyle": "normal",
                    "fontWeight": "600",
                    "lineHeight": "1.1"
                }
            },
            "caption": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--poppins)",
                    "fontSize": "var(--wp--preset--font-size--text-small)",
                    "fontStyle": "normal",
                    "fontWeight": "400",
                    "lineHeight": "1.6"
                }
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--poppins)",
            "fontSize": "var(--wp--preset--font-size--text)",
            "fontStyle": "normal",
            "fontWeight": "400",
            "lineHeight": "1.6"
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header"
        },
        {
            "area": "footer",
            "name": "footer"
        }
    ],
    "version": 2
}